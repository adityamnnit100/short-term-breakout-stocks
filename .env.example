# Application Configuration
APP_NAME=Stocks Trader Pro
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# API Keys (get from respective services)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Cache Configuration
CACHE_DIR=./cache
CACHE_CLEANUP_INTERVAL=3600

# Request Limits
REQUEST_TIMEOUT=10
MAX_NEWS_ARTICLES=20
MAX_BACKTEST_DAYS=365

# UI Configuration
THEME=dark
MAX_CHART_HEIGHT=600

# Login Configuration
# Generate a password hash with:
# python -m alphascanner_ui.auth
# This env user is your owner/admin account. Add friends later from Settings > Account Access.
ALPHASCANNER_AUTH_USERNAME=kumar
ALPHASCANNER_AUTH_PASSWORD_HASH=pbkdf2_sha256$260000$replace_with_generated_salt$replace_with_generated_hash
ALPHASCANNER_ALLOW_SIGNUP=true
# Optional. If set, users need this code on the Sign Up screen.
ALPHASCANNER_SIGNUP_CODE=
